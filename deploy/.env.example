# Copy to deploy/.env on the SERVER, chmod 600. Never use demo credentials.
KAN_RELEASE=20261006-task-control-2
# Generate each separately with openssl rand -hex 32; use hex for the DB URL.
KAN_DB_PASSWORD=
BETTER_AUTH_SECRET=

# Keep public sign-up closed. Create the first account before exposing the domain.
NEXT_PUBLIC_DISABLE_SIGN_UP=true

# Fill these when the real Telegram bot gateway is ready; blank token disables API.
TASK_CONTROL_SERVICE_TOKEN=
# Enter the fixed public IP of the bot server here (not the Redmine/Kan server).
TASK_CONTROL_ALLOWED_IPS=
# Exact TCP peer of host Nginx as seen by Kan, determined after deployment.
TASK_CONTROL_TRUSTED_PROXIES=
TASK_CONTROL_GATEWAY_URL=
TASK_CONTROL_GATEWAY_TOKEN=
